# Karachi Mart Supermarket - Environment Configuration
# Copy this file to .env or configure in your Vercel Dashboard

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Safe for frontend use - NEVER use service-role key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Karachi Mart Brand & Operating Parameters
VITE_CURRENCY=PKR
VITE_STORE_CITY=Karachi
VITE_FREE_DELIVERY_THRESHOLD=2000
VITE_STANDARD_DELIVERY_FEE=150
